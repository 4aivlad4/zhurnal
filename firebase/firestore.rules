// Правила доступа к базе Firestore: читать и писать могут только свои — по списку UID
// (Firebase → Authentication → Users → User UID). Без входа база ничего не отдаёт.
// Владелец вставляет этот текст в консоль: Firestore Database → Rules → Publish
// (карточка docs/tasks/0.2-firebase.md, шаг 5). Меняются только вместе с владельцем.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null
        && request.auth.uid in [
          'etgWzTUIxIWo6oJhyzrCk9Gr89d2',  // jaba@example.com — «Жаба 1»
          'oCwFmkeE6tN8u63Z3EDaU8ExWbn1',  // jaba2@example.com — «Жаба 2»
          '7Q3W5VG9RbRur0g5YRNBYa1VFql1',  // jaba3@example.com — «Жаба 3»
          'PbTrhmWi2OhxeJglwy98v56CSdp1'   // admin@example.com — владелец («Другой»)
        ];
    }

    match /{document=**} {
      allow read, write: if isFamily();
    }
  }
}
